{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "paths": { "@shared/*": ["./src/shared/*"], "@renderer/*": ["./src/renderer/*"] }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/preload/*.d.ts"]
}
